# Copy to .env and load it in the process environment before starting services.
# Never commit the copied .env file.

NACOS_SERVER_ADDR=localhost:8848
NACOS_NAMESPACE=

XY_RMQ_NAMESRV=localhost:9876
XY_RMQ_ACCESS_KEY=CHANGE_ME
XY_RMQ_SECRET_KEY=CHANGE_ME

XY_DB_JDBC_URL=jdbc:mysql://127.0.0.1:3306/xy_live_user?useUnicode=true&characterEncoding=utf8&allowPublicKeyRetrieval=true
XY_DB_USERNAME=root
XY_DB_PASSWORD=CHANGE_ME

XY_ID_DB_URL=jdbc:mysql://127.0.0.1:3306/xy_live_common?useUnicode=true&characterEncoding=utf8
XY_ID_DB_USERNAME=root
XY_ID_DB_PASSWORD=CHANGE_ME

SPRING_DATA_REDIS_URL=redis://127.0.0.1:6379
SPRING_DATA_REDIS_PASSWORD=
SPRING_DATA_REDIS_DATABASE=3
