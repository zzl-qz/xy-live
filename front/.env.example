# Vite proxies /api to this origin in development. The gateway runs on 9191 by default.
VITE_BACKEND_ORIGIN=http://localhost:9191
# Set this to the gateway route prefix from Nacos, e.g. /live/api. Empty means direct controller paths.
VITE_BACKEND_PREFIX=
# Optional: use a separate API origin in production. Leave empty when your web server proxies /api.
VITE_API_ORIGIN=
# Optional playback URL pattern. {roomId} is replaced with the current room ID.
# VITE_STREAM_URL_TEMPLATE=https://media.example.com/live/{roomId}/index.m3u8
